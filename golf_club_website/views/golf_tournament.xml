<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_golf_tournament_list" model="ir.ui.view">
        <field name="name">view.golf.tournament.list</field>
        <field name="model">golf.tournament</field>
        <field name="inherit_id" ref="golf_club.view_golf_tournament_list" />
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="website_published" />
            </field>

        </field>
    </record>
    <record id="view_golf_tournament_form" model="ir.ui.view">
        <field name="name">view.golf.tournament.form</field>
        <field name="model">golf.tournament</field>
        <field name="inherit_id" ref="golf_club.view_golf_tournament_form" />
        <field name="arch" type="xml">
            <field name="active_card_count" position="before">
                <field name="website_url" invisible="1" />
                <field name="is_published" widget="website_redirect_button" />

            </field>
            <field name="default_product_id" position="after">
                <field name="website_published" />
            </field>
        </field>
    </record>
    <record id="view_golf_tournament_search" model="ir.ui.view">
        <field name="name">view.golf.tournament.search</field>
        <field name="model">golf.tournament</field>
        <field name="inherit_id" ref="golf_club.view_golf_tournament_search" />
        <field name="arch" type="xml">
            <filter name="type_golf_tournament_cancelled" position="after">
                <separator />
                <filter string="Published in website" name="filter_published" domain="[('website_published', '=', True)]" />
            </filter>
        </field>
    </record>
    <record id="action_golf_home_page" model="ir.actions.client">
        <field name="name">Golf Home</field>
        <field name="tag">golf.homepage</field>
    </record>
    <record id="golf_tournament_toggle_website_published" model="ir.actions.server">
        <field name="name">Toggle website published</field>
        <field name="binding_model_id" ref="golf_club.model_golf_tournament" />
        <field name="binding_view_types">list,form</field>
        <field name="model_id" ref="golf_club.model_golf_tournament" />
        <field name="state">code</field>
        <field name="code">action = records.action_toggle_website_published()</field>
    </record>

</odoo>