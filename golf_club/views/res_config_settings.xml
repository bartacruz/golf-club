<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.golf</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90" />
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <!-- 1. CAMBIO CLAVE: Apuntamos al formulario para insertar el bloque de la app -->
            <xpath expr="//form" position="inside">
                <app_settings_block title="Golf" string="Golf" data-key="golf_club">
                    
                    <!-- SECCIÓN: DATOS DEL CLUB -->
                    <h2>Datos del club</h2>
                    <div class="row mt16 o_settings_container">
                        <setting string="Club ID" help="Identificador único del club de golf">
                            <field name="golf_club_id" />
                        </setting>
                    </div>

                    <!-- SECCIÓN: FACTURACIÓN -->
                    <h2>Facturación</h2>
                    <div class="row mt16 o_settings_container">
                        <!-- Grupo de Productos y Membresías -->
                        <setting string="Membresías" help="Configuración de precios y productos para socios">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="golf_members_pricelist" class="col-lg-4 o_light_label" string="Lista de precios"/>
                                    <field name="golf_members_pricelist" class="col-lg-8"/>
                                </div>
                                <div class="row mt8">
                                    <label for="golf_default_product" class="col-lg-4 o_light_label" string="Producto Socio"/>
                                    <field name="golf_default_product" class="col-lg-8"/>
                                </div>
                            </div>
                        </setting>

                        <!-- Grupo de Green Fees -->
                        <setting string="Green Fees" help="Productos aplicables a torneos">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="golf_tournament_product" class="col-lg-4 o_light_label" string="Semanal"/>
                                    <field name="golf_tournament_product" class="col-lg-8"/>
                                </div>
                                <div class="row mt8">
                                    <label for="golf_tournament_product_weekend" class="col-lg-4 o_light_label" string="Fin de semana"/>
                                    <field name="golf_tournament_product_weekend" class="col-lg-8"/>
                                </div>
                            </div>
                        </setting>
                    </div>

                    <!-- SECCIÓN: IMPORTACIÓN -->
                    <h2>Importación</h2>
                    <div class="row mt16 o_settings_container">
                        <setting string="Configuración por defecto" help="Valores aplicados a los torneos importados">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="golf_default_identification_type" class="col-lg-4 o_light_label" string="Tipo de doc."/>
                                    <field name="golf_default_identification_type" class="col-lg-8"/>
                                </div>
                                <div class="row mt8">
                                    <label for="golf_default_responsibility" class="col-lg-4 o_light_label" string="Resp. AFIP"/>
                                    <field name="golf_default_responsibility" class="col-lg-8"/>
                                </div>
                                <div class="row mt8">
                                    <label for="golf_default_field_18" class="col-lg-4 o_light_label" string="Campo 18 hoyos"/>
                                    <field name="golf_default_field_18" class="col-lg-8"/>
                                </div>
                                <div class="row mt8">
                                    <label for="golf_default_field_9" class="col-lg-4 o_light_label" string="Campo 9 hoyos"/>
                                    <field name="golf_default_field_9" class="col-lg-8"/>
                                </div>
                            </div>
                        </setting>
                    </div>

                </app_settings_block>
            </xpath>
        </field>
    </record>
</odoo>
