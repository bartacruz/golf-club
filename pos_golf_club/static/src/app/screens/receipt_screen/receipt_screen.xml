<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_golf_club.ReceiptScreen" t-inherit="point_of_sale.ReceiptScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('receipt-options')]/div" position="after">
            <!-- <t t-if="this.pos.get_order().eventRegistrations.length > 0"> -->
             <div class="d-flex gap-1">
                <button class="button print btn btn-lg btn-secondary w-100 py-3" t-on-click="printGolfCard">
                    <i t-attf-class="fa {{printGolfCard.status === 'loading' ? 'fa-fw fa-spin fa-circle-o-notch' : 'fa-flag'}} me-1" />Print Golf Card
                </button>
            </div>
            <!-- </t> -->
        </xpath>
    </t>
</templates>